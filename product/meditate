#!/usr/bin/env bash
# meditate — read your Claude Code sessions, find the threads, resume one.
#
#   meditate              every session, ranked by how tangled it is
#   meditate sessions     the same, explicitly
#   meditate split <id>   split one session into continuation chats
#   meditate threads      the live threads across every split session
#   meditate open         open a Terminal per live thread (macOS)
#   meditate archive      set down finished sessions (dry-run unless --apply)
#   meditate repo         the optional repo lens
#   meditate test         run the suite
#
# This is the STANDALONE product's CLI. The working checkout has a different
# script by the same name that also starts a desktop companion and a local
# server; that one is not part of this product and is not shipped.
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
PY="${MEDITATE_PYTHON:-python3}"

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  ""|full)   exec "$PY" "$DIR/sessions.py" ;;
  sessions)  shift; exec "$PY" "$DIR/sessions.py" "$@" ;;
  split)     shift
             [ $# -gt 0 ] || { echo "which session? try: meditate sessions"; exit 2; }
             exec "$PY" "$DIR/sessions.py" --session "$1" --json ;;
  threads)   shift; exec "$PY" "$DIR/launch.py" "$@" ;;
  open)      shift; exec "$PY" "$DIR/launch.py" --open "$@" ;;
  archive)   shift; exec "$PY" "$DIR/archive.py" "$@" ;;
  repo)      shift; exec "$PY" "$DIR/still.py" "$@" ;;
  scan)      shift; exec "$PY" "$DIR/scan_projects.py" "$@" ;;
  test)
    fail=0
    for t in "$DIR"/test_*.py; do
      printf '%-26s ' "$(basename "$t")"
      if out=$("$PY" "$t" 2>&1); then echo "$out" | tail -1
      else fail=1; echo "$out" | tail -1; fi
    done
    exit $fail ;;
  -h|--help|help) usage ;;
  *) echo "no such command: $1"; echo; usage; exit 2 ;;
esac
