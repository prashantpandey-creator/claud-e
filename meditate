#!/usr/bin/env bash
# meditate — one command, from anywhere.
#
#   meditate           health check (doctor)
#   meditate grade     scan sessions → grade into nidra → sleep pass
#   meditate sessions  show all sessions ranked by sprawl
#   meditate launch    see live threads (add --open to open Terminal windows)
#   meditate install   run the installer
#   meditate help      this message

set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"

case "${1:-}" in
  casper|mascot|ghost|companion)
    shift
    # The NATIVE desktop companion — an .app bundle, not a bare binary. The
    # bundle is not cosmetic: macOS only grants microphone and speech access to
    # a signed bundle with usage strings in its Info.plist, so "he listens"
    # depends on packaging before it depends on code.
    NEWEST=$(ls -t "$DIR/mascot"/*.swift 2>/dev/null | head -1)
    CBIN="$DIR/mascot/Casper.app/Contents/MacOS/casper"
    REBUILT=no
    if [ ! -x "$CBIN" ] || [ -n "$NEWEST" -a "$NEWEST" -nt "$CBIN" ]; then
      echo "  building Casper..."
      bash "$DIR/mascot/build.sh" >/dev/null || {
        echo "  couldn't build the companion (needs Xcode command line tools)"; exit 1; }
      REBUILT=yes
    fi

    # A stale privacy record kills him at launch, and it does not need the
    # signing identity to have changed -- build.sh only clears the record in
    # that case, so this one gets through. The symptom is a SIGABRT inside
    # __TCC_CRASHING_DUE_TO_PRIVACY_VIOLATION__ with a report that says the
    # Info.plist "must contain an NSSpeechRecognitionUsageDescription key"
    # while the key is sitting right there in the plist. Observed 2026-08-25.
    # If the last launch died that way, clear the record and let macOS re-read
    # the plist. Costs one Allow click, and only after a crash.
    LASTCRASH=$(ls -t "$HOME/Library/Logs/DiagnosticReports"/casper-*.ips 2>/dev/null | head -1)
    if [ -n "$LASTCRASH" ] && ! pgrep -f "$DIR/mascot/Casper.app/Contents" >/dev/null 2>&1 \
       && grep -q '"namespace":"TCC"' "$LASTCRASH" 2>/dev/null; then
      echo "  his last launch was blocked by a stale privacy record — clearing it"
      for s in SpeechRecognition Microphone AppleEvents; do
        tccutil reset "$s" com.meditate.casper >/dev/null 2>&1 || true
      done
      mv "$LASTCRASH" "$LASTCRASH.handled" 2>/dev/null || true
    fi

    # Already awake and current? Then raise him and stop.
    #
    # These two lines used to run unconditionally, which meant that with
    # several sessions open at once, whichever one typed `meditate casper`
    # killed the Casper the others were using -- and if a rebuild was mid-swap
    # the freshly opened app was SIGKILLed for "Code Signature Invalid"
    # instead of drawing. Measured on 2026-08-25: 25 launch/death pairs inside
    # 60 seconds, and from the owner's side he "closed automatically".
    if [ "$REBUILT" = no ] && pgrep -f "$DIR/mascot/Casper.app/Contents" >/dev/null 2>&1; then
      open "$DIR/mascot/Casper.app"   # activates the running one, starts nothing
      echo "Casper is already awake — bottom-right of your screen."
      exit 0
    fi
    pkill -f "$DIR/mascot/Casper.app/Contents" 2>/dev/null || true
    pkill -x casper 2>/dev/null || true
    # The good voice: a loopback server holding the Kokoro model warm. Cold,
    # every line pays ~4s before the first sound; warm, ~2s. Skipped silently
    # when the model or python3.10 is absent — Casper falls back to Apple.
    if ! curl -s -m 1 http://127.0.0.1:7712/ping >/dev/null 2>&1; then
      if python3.10 "$DIR/tts.py" --check >/dev/null 2>&1; then
        (nohup python3.10 "$DIR/tts.py" --serve >>"$HOME/.claude/meditation/tts.log" 2>&1 &)
        echo "  warming his voice (Kokoro, local)…"
      fi
    fi
    open "$DIR/mascot/Casper.app"
    echo "Casper is awake — bottom-right of your screen. Drag him anywhere."
    echo "Click him and talk, or say \"Casper, ...\" — he answers from what he"
    echo "knows about your work. Everything he hears stays on this Mac."
    ;;
  install)
    bash "$DIR/install.sh"
    ;;
  uninstall|remove)
    shift
    bash "$DIR/uninstall.sh" "$@"
    ;;
  doctor)
    shift
    python3 "$DIR/doctor.py" "$@"
    ;;
  help|--help|-h)
    echo "meditate — evidence-graded memory, and a fleet that works from it"
    echo ""
    echo "  meditate            where you are + the ONE next action"
    echo "  meditate go [N]     move it forward: a repair agent if knowledge"
    echo "                      broke, plus one per open goal (N caps; 0 = dry run)"
    echo "  meditate fix        repair broken memories only"
    echo "  meditate pulse      the live console in your browser"
    echo ""
    echo "  meditate doctor     tests, hook, heartbeat, store"
    echo "  meditate install / uninstall"
    echo ""
    echo "  Inside Claude Code: /meditate  — read the sessions, split the tangled ones"
    echo ""
    echo "Everything else runs itself on the heartbeat. The organs are still"
    echo "there as scripts in this directory if you ever need one by hand:"
    echo "  python3 $DIR/<name>.py --help"
    ;;
  "")
    python3 "$DIR/status.py"
    ;;
  go|run|work|act)
    shift
    python3 "$DIR/go.py" "$@"
    ;;
  fix|repair)
    shift
    python3 "$DIR/go.py" --repair-only "$@"
    ;;
  pulse|live|sarathi|brain|serve|watch|soul)
    shift
    python3 "$DIR/brain.py" "$@"
    ;;
  *)
    # Passthrough, not a menu. Every organ is still a script in this
    # directory; naming one runs it. That keeps 30+ capabilities reachable
    # without 30+ hand-maintained branches drifting out of date -- the old
    # fallback listed six verbs that no longer existed.
    # A few organs were renamed over time; keep the old names working.
    case "$1" in
      grade)    shift; exec python3 "$DIR/nidra_bridge.py" --sleep "$@" ;;
      distill)  shift; exec python3 "$DIR/formation.py" "$@" ;;
      drift)    shift; exec python3 "$DIR/coordination.py" drift "$@" ;;
      who)      shift; exec python3 "$DIR/coordination.py" who "$@" ;;
      where)    shift; exec python3 "$DIR/paths.py" "$@" ;;
      progress) shift; exec python3 "$DIR/beacon.py" "$@" ;;
    esac
    if [ -f "$DIR/$1.py" ]; then
      cmd="$1"; shift
      exec python3 "$DIR/$cmd.py" "$@"
    fi
    echo "don't know '$1'." >&2
    echo "  meditate            where you are + the one next action" >&2
    echo "  meditate go         move everything forward" >&2
    echo "  meditate fix        repair broken memories" >&2
    echo "  meditate pulse      the live console" >&2
    echo "  meditate help       everything else" >&2
    exit 1
    ;;
esac
