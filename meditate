#!/usr/bin/env bash
# meditate — one command, from anywhere.
#
#   meditate           health check (doctor)
#   meditate grade     scan sessions → grade into nidra → sleep pass
#   meditate sessions  show all sessions ranked by sprawl
#   meditate launch    see live threads (add --open to open Terminal windows)
#   meditate install   run the installer
#   meditate help      this message

set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"

case "${1:-}" in
  grade)
    shift
    python3 "$DIR/nidra_bridge.py" --sleep "$@"
    ;;
  sessions)
    shift
    python3 "$DIR/sessions.py" "$@"
    ;;
  launch)
    shift
    python3 "$DIR/launch.py" "$@"
    ;;
  install)
    bash "$DIR/install.sh"
    ;;
  metrics)
    shift
    python3 "$DIR/metrics.py" "$@"
    ;;
  doctor)
    shift
    python3 "$DIR/doctor.py" "$@"
    ;;
  archive)
    shift
    python3 "$DIR/archive.py" "$@"
    ;;
  drive)
    shift
    python3 "$DIR/drive.py" "$@"
    ;;
  dashboard)
    shift
    python3 "$DIR/dashboard.py" "$@"
    ;;
  distill)
    shift
    python3 "$DIR/formation.py" "$@"
    ;;
  ask|what|search|find|recall)
    shift
    python3 "$DIR/ask.py" "$@"
    ;;
  goals)
    shift
    python3 "$DIR/goals.py" "$@"
    ;;
  report)
    shift
    python3 "$DIR/report.py" "$@"
    ;;
  drift)
    shift
    python3 "$DIR/coordination.py" drift "$@"
    ;;
  who)
    shift
    python3 "$DIR/coordination.py" who "$@"
    ;;
  help|--help|-h)
    echo "meditate — evidence-graded memory + goal fleet"
    echo ""
    echo "EVERY DAY"
    echo "  meditate            where am I + the ONE next action"
    echo "  meditate brief      the catch-up, in sentences"
    echo "  meditate go [N]     move everything forward: a repair agent if the"
    echo "                      queue is open, plus one per open goal"
    echo "                      (N caps it; 0 = dry run)"
    echo "  meditate fix        repair failed memories only"
    echo ""
    echo "SEEING IT"
    echo "  meditate pulse      the live console in your browser"
    echo "  meditate casper     the desktop companion (talks, listens)"
    echo "  meditate say ...    ask it something out loud"
    echo "  meditate advise ... ask it to reason over what it knows"
    echo ""
    echo "CHATS"
    echo "  meditate chats      which chats are waiting on you"
    echo "  meditate sessions   every session, ranked by sprawl"
    echo "  meditate tell ID .. send a message into another session"
    echo "  meditate inbox      messages sent to this one"
    echo "  meditate archive    put finished chats away (restorable)"
    echo ""
    echo "GOALS"
    echo "  meditate goals      goals, stuck first then closest to done"
    echo "  meditate milestones which milestones are already true"
    echo "  meditate fleet      what the agents are doing right now"
    echo "  meditate launch     open live threads in Terminal"
    echo "  meditate progress   an agent reports in (agents call this)"
    echo ""
    echo "WHAT IT KNOWS"
    echo "  meditate recall ... search the graded facts"
    echo "  meditate grade      re-check every memory against reality"
    echo "  meditate drift      memories that stopped matching"
    echo "  meditate report     caught / repaired / time-to-repair"
    echo "  meditate projects   where your attention actually went"
    echo ""
    echo "KEEPING IT HEALTHY"
    echo "  meditate doctor     tests, hook, heartbeat, store"
    echo "  meditate install    set it up on this machine"
    echo "  meditate who        other sessions live in this repo"
    echo "  meditate metrics    raw counters"
    echo ""
    echo "  Inside Claude Code: /meditate"
    ;;
  "")
    python3 "$DIR/status.py"
    ;;
  go|run|work|act)
    shift
    python3 "$DIR/go.py" "$@"
    ;;
  fix|repair)
    shift
    python3 "$DIR/go.py" --repair-only "$@"
    ;;
  casper|mascot|ghost|companion)
    shift
    # The NATIVE desktop companion — an .app bundle, not a bare binary. The
    # bundle is not cosmetic: macOS only grants microphone and speech access to
    # a signed bundle with usage strings in its Info.plist, so "he listens"
    # depends on packaging before it depends on code.
    NEWEST=$(ls -t "$DIR/mascot"/*.swift 2>/dev/null | head -1)
    if [ ! -x "$DIR/mascot/Casper.app/Contents/MacOS/casper" ] \
       || [ -n "$NEWEST" -a "$NEWEST" -nt "$DIR/mascot/Casper.app/Contents/MacOS/casper" ]; then
      echo "  building Casper..."
      bash "$DIR/mascot/build.sh" >/dev/null || {
        echo "  couldn't build the companion (needs Xcode command line tools)"; exit 1; }
    fi
    pkill -f "$DIR/mascot/Casper.app/Contents" 2>/dev/null || true
    pkill -x casper 2>/dev/null || true
    # The good voice: a loopback server holding the Kokoro model warm. Cold,
    # every line pays ~4s before the first sound; warm, ~2s. Skipped silently
    # when the model or python3.10 is absent — Casper falls back to Apple.
    if ! curl -s -m 1 http://127.0.0.1:7712/ping >/dev/null 2>&1; then
      if python3.10 "$DIR/tts.py" --check >/dev/null 2>&1; then
        (nohup python3.10 "$DIR/tts.py" --serve >>"$HOME/.claude/meditation/tts.log" 2>&1 &)
        echo "  warming his voice (Kokoro, local)…"
      fi
    fi
    open "$DIR/mascot/Casper.app"
    echo "Casper is awake — bottom-right of your screen. Drag him anywhere."
    echo "Click him and talk, or say \"Casper, ...\" — he answers from what he"
    echo "knows about your work. Everything he hears stays on this Mac."
    ;;
  stop|halt)
    shift
    # Close every agent THIS tool dispatched, and nothing else — the window
    # ids were recorded at launch precisely so this cannot take out the
    # session you are typing in.
    python3 -c "
import sys; sys.path.insert(0, '$DIR')
from drive import stop_fleet
r = stop_fleet()
if not r['was_running']:
    print('Nothing of mine is running.')
else:
    print('Stopped %d agent(s).' % r['count'])
    for a in r['closed']:
        print('  %s  (%d min in)' % (a['goal'], a['age_min']))
    for a in r['failed']:
        print('  could not close: %s' % a['goal'])
"
    ;;
  advise|advice|think)
    shift
    python3 "$DIR/advisor.py" "$@"
    ;;
  pulse|live|sarathi|brain|serve|watch|soul)
    shift
    python3 "$DIR/brain.py" "$@"
    ;;
  say|talk|hey)
    shift
    python3 "$DIR/converse.py" "$@"
    ;;
  voice|whisper)
    shift
    python3 "$DIR/voice.py" "$@"
    ;;
  brief|catchup|"catch-up")
    shift
    python3 "$DIR/brief.py" "$@"
    ;;
  chats|triage|waiting)
    shift
    python3 "$DIR/triage.py" "$@"
    ;;
  milestones|check-goals|verify-goals)
    shift
    python3 "$DIR/milestones.py" "$@"
    ;;
  projects|proj|where)
    shift
    python3 "$DIR/projects.py" "$@"
    ;;
  cadence|tempo|rhythm)
    shift
    python3 "$DIR/cadence.py" "$@"
    ;;
  progress|report-progress)
    shift
    python3 "$DIR/beacon.py" "$@"
    ;;
  tell|msg|message)
    shift
    python3 "$DIR/inbox.py" send "$@"
    ;;
  inbox|mail)
    shift
    python3 "$DIR/inbox.py" read "$@"
    ;;
  messages)
    shift
    python3 "$DIR/inbox.py" list "$@"
    ;;
  remote)
    shift
    python3 "$DIR/remote.py" "$@"
    ;;
  fleet|agents)
    shift
    python3 "$DIR/drive.py" fleet "$@"
    ;;
  state|status)
    shift
    python3 "$DIR/status.py" "$@"
    ;;
  *)
    echo "don't know '$1'. The product is:" >&2
    echo "  meditate            where am I + the one next action" >&2
    echo "  meditate go         move everything forward" >&2
    echo "  meditate ask \"...\"  question the graded memory" >&2
    echo "  meditate fix        repair knowledge (--list, or fix <n> for one item)" >&2
    echo "  meditate say \"...\"  talk to it: ask about a project, memory, or status" >&2
    echo "  meditate voice      Casper: the one thing worth saying + if now is the moment" >&2
    echo "  meditate projects   where your attention went, per project + open tasks" >&2
    echo "  meditate fleet      live progress of dispatched agents" >&2
    echo "  meditate casper     the desktop companion — a ghost that watches and asks" >&2
    echo "  meditate advise \"...\" a junior-dev opinion on your real state" >&2
    echo "  meditate pulse      your Claude live in the browser — click to run (localhost)" >&2
    echo "everything else runs itself on the heartbeat (meditate help for plumbing)" >&2
    exit 1
    ;;
esac
